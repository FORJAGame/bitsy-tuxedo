{
	"name": "bitsy-tuxedo",
	"productName": "Bitsy Tuxedo",
	"version": "0.1.0",
	"description": "Editor Bitsy Tuxedo para desktop (Electron) com updates OTA",
	"license": "MIT",
	"author": "FORJAGame",
	"homepage": "https://tuxedo.forjagame.com/",
	"main": "src/main.js",
	"bitsy": {
		"otaUrl": "https://tuxedo.forjagame.com/ota-manifest.json",
		"otaIntervalMs": 3600000
	},
	"scripts": {
		"prepare-seed": "node scripts/prepare-seed.js",
		"start": "electron .",
		"dist": "npm run prepare-seed && electron-builder --publish never",
		"release": "npm run prepare-seed && electron-builder --publish always"
	},
	"dependencies": {
		"electron-updater": "^6.3.9"
	},
	"devDependencies": {
		"electron": "^33.2.0",
		"electron-builder": "^25.1.8"
	},
	"build": {
		"appId": "com.forjagame.bitsytuxedo",
		"productName": "Bitsy Tuxedo",
		"files": [
			"src/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "seed",
				"to": "seed"
			}
		],
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "FORJAGame",
				"repo": "bitsy-tuxedo",
				"releaseType": "release"
			}
		],
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Graphics",
			"icon": "build/icon.png",
			"artifactName": "Bitsy-Tuxedo.${ext}"
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "build/icon.png",
			"artifactName": "Bitsy-Tuxedo-Setup.${ext}"
		},
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"universal"
					]
				},
				{
					"target": "zip",
					"arch": [
						"universal"
					]
				}
			],
			"category": "public.app-category.graphics-design",
			"icon": "build/icon.png",
			"artifactName": "Bitsy-Tuxedo-mac.${ext}"
		}
	}
}
